{
  "RecipeFormatVersion": "2020-01-25",
  "ComponentName": "com.iotconnect.sdk2",
  "ComponentVersion": "1.0.2",
  "ComponentDescription": "Softweb Core Component",
  "ComponentPublisher": "Softweb",
  "ComponentConfiguration": {
    "DefaultConfiguration": {
      "message": "hi",
      "accessControl": {
        "aws.greengrass.ipc.mqttproxy": {
          "com.iotconnect.sdk2:mqttproxy:1": {
            "policyDescription": "Allows access to pub/sub to mypi/mqtt.",
            "operations": [
              "aws.greengrass#SubscribeToIoTCore",
              "aws.greengrass#PublishToIoTCore"
            ],
            "resources": ["*"]
          }
        },
        "aws.greengrass.ipc.pubsub": {
          "com.iotconnect.sdk2:pubsub:1": {
            "policyDescription": "Allows access to publish to mypi/button.",
            "operations": [
              "aws.greengrass#PublishToTopic",
              "aws.greengrass#SubscribeToTopic"
            ],
            "resources": ["*"]
          }
        }
      }
    }
  },
  "Manifests": [
    {
      "Platform": { "os": "*" },
      "Lifecycle": {
        "Install": {
          "RequiresPrivilege": true,
          "script": "python3 -m pip install --user awsiotsdk"
        },
        "setenv": {
          "CPID": "<your CPID>",
          "ENV": "<environment, poc, preqa or prod>",
          "URL": "<discovery url, environment specific>"
        },
        "Run": {
          "RequiresPrivilege": true,
          "script": "python3 -u {artifacts:path}/iotconnect_sdk.py '{configuration:/message}'"
        }
      },
      "Artifacts": [
        {
          "Uri": "s3://root-<account-id>/greengrass_template/artifacts/com.iotconnect.sdk2/1.0.2/iotconnect_sdk.py",
          "Unarchive": "NONE",
          "Permission": { "Read": "OWNER", "Execute": "NONE" }
        }
      ]
    }
  ]
}
